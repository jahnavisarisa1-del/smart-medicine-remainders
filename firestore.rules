rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /patients/{patientId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientUID ||
        request.auth.uid in resource.data.linkedCaregiverUIDs
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.patientUID && request.auth.uid == patientId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.patientUID ||
        (request.auth.uid in resource.data.linkedCaregiverUIDs &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedCaregiverUIDs'])) ||
        (request.auth.token.email != null &&
         request.auth.token.email.lower() in resource.data.familyMemberEmails &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedCaregiverUIDs']))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.patientUID;
    }
    match /caregiverLinks/{linkId} {
      allow read, write: if request.auth != null && request.auth.uid == linkId;
    }
  }
}
